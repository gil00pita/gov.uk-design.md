{
  "schemaVersion": 1,
  "reviewedAt": "2026-09-09",
  "adapters": [
    {
      "id": "codex",
      "name": "Codex and AGENTS.md-compatible agents",
      "sourceUrl": "https://learn.chatgpt.com/docs/agent-configuration/agents-md",
      "output": "ai/AGENTS.md",
      "destination": "AGENTS.md",
      "mode": "managed-block"
    },
    {
      "id": "claude-code",
      "name": "Claude Code",
      "sourceUrl": "https://code.claude.com/docs/en/memory",
      "output": "ai/CLAUDE.md",
      "destination": "CLAUDE.md",
      "mode": "managed-block"
    },
    {
      "id": "gemini-cli",
      "name": "Gemini CLI",
      "sourceUrl": "https://geminicli.com/docs/cli/gemini-md/",
      "output": "ai/GEMINI.md",
      "destination": "GEMINI.md",
      "mode": "managed-block"
    },
    {
      "id": "github-copilot",
      "name": "GitHub Copilot",
      "sourceUrl": "https://docs.github.com/en/copilot/how-tos/configure-custom-instructions-in-your-ide/add-repository-instructions-in-your-ide",
      "output": "ai/copilot-instructions.md",
      "destination": ".github/copilot-instructions.md",
      "mode": "managed-block"
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "sourceUrl": "https://cursor.com/docs/rules",
      "output": "ai/govuk-design-system.mdc",
      "destination": ".cursor/rules/govuk-design-system.mdc",
      "mode": "file"
    }
  ]
}
