{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gil00pita/gov.uk-design.md/blob/main/schema/framework-adapters.schema.json",
  "title": "GOV.UK framework adapter source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewedAt", "govukFrontendVersion", "adapters"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "reviewedAt": { "type": "string", "format": "date" },
    "govukFrontendVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/adapter" }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "reviewedAt",
        "description",
        "output",
        "fixture",
        "fixtureDescription",
        "compatibility",
        "requirements",
        "assetSetup",
        "rendering",
        "progressiveEnhancement",
        "lifecycle",
        "pageTemplateIntro",
        "pageTemplateLanguage",
        "pageTemplate",
        "dynamicExampleIntro",
        "dynamicExampleLanguage",
        "dynamicExample",
        "sourceUrls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["reference", "experimental", "stable"] },
        "reviewedAt": { "type": "string", "format": "date" },
        "description": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "fixture": { "type": "string", "minLength": 1 },
        "fixtureDescription": { "type": "string", "minLength": 1 },
        "compatibility": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["guidance", "token", "markup", "behaviour-tested"]
          }
        },
        "requirements": { "$ref": "#/$defs/nonEmptyStrings" },
        "assetSetup": { "$ref": "#/$defs/nonEmptyStrings" },
        "rendering": { "$ref": "#/$defs/nonEmptyStrings" },
        "progressiveEnhancement": { "$ref": "#/$defs/nonEmptyStrings" },
        "lifecycle": { "$ref": "#/$defs/nonEmptyStrings" },
        "pageTemplateIntro": { "type": "string", "minLength": 1 },
        "pageTemplateLanguage": {
          "enum": ["html", "jsx", "js", "ts", "tsx"]
        },
        "pageTemplate": { "type": "string", "minLength": 1 },
        "dynamicExampleIntro": { "type": "string", "minLength": 1 },
        "dynamicExampleLanguage": {
          "enum": ["js", "jsx", "ts", "tsx"]
        },
        "dynamicExample": { "type": "string", "minLength": 1 },
        "sourceUrls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    }
  }
}
