{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gil00pita/gov.uk-design.md/blob/main/schema/style.schema.json",
  "title": "GOV.UK style or foundation record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "category",
    "group",
    "summary",
    "source",
    "rules",
    "accessibility",
    "restrictions",
    "tokenRefs",
    "examples"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "const": "style" },
    "group": { "enum": ["page-structure", "typography", "visual-elements"] },
    "summary": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guidanceUrl", "implementationUrl", "govukFrontendVersion", "reviewedAt"],
      "properties": {
        "guidanceUrl": { "type": "string", "format": "uri" },
        "implementationUrl": { "type": "string", "format": "uri" },
        "govukFrontendVersion": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date" }
      }
    },
    "rules": { "$ref": "#/$defs/nonEmptyStrings" },
    "accessibility": { "$ref": "#/$defs/nonEmptyStrings" },
    "restrictions": { "$ref": "#/$defs/nonEmptyStrings" },
    "tokenRefs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "language", "code"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "language": { "enum": ["html", "css", "scss"] },
          "code": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
