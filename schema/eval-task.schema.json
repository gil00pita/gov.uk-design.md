{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gilalvaro/govuk-design-md/blob/main/schema/eval-task.schema.json",
  "title": "GOV.UK agent evaluation suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewedAt", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reviewedAt": { "type": "string", "format": "date" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimensions", "prompt", "expectedRecords", "rubric"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "dimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "record-selection",
                "markup-fidelity",
                "progressive-enhancement",
                "accessibility",
                "non-invention"
              ]
            }
          },
          "prompt": { "type": "string", "minLength": 1 },
          "expectedRecords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "id"],
              "properties": {
                "kind": { "enum": ["style", "component", "pattern"] },
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                }
              }
            }
          },
          "rubric": {
            "type": "object",
            "additionalProperties": false,
            "required": ["must", "mustNot"],
            "properties": {
              "must": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "mustNot": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
