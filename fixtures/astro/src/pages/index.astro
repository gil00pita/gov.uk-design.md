---
import 'govuk-frontend/dist/govuk/govuk-frontend.min.css'
---

<!doctype html>
<html class="govuk-template" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1d70b8" />
    <title>GOV.UK Design MD Astro fixture</title>
    <link rel="icon" sizes="48x48" href="/assets/images/favicon.ico" />
  </head>
  <body class="govuk-template__body">
    <script is:inline>
      document.body.className += ' js-enabled' + ('noModule' in HTMLScriptElement.prototype ? ' govuk-frontend-supported' : '');
    </script>

    <div data-govuk-astro-boundary>
      <a class="govuk-skip-link" href="#main-content" data-module="govuk-skip-link">
        Skip to main content
      </a>

      <div class="govuk-width-container">
        <main class="govuk-main-wrapper" id="main-content">
          <h1 class="govuk-heading-xl">GOV.UK Design MD Astro fixture</h1>

          <section aria-labelledby="astro-button-heading" class="govuk-!-margin-bottom-9">
            <h2 class="govuk-heading-l" id="astro-button-heading">Button</h2>
            <button class="govuk-button" data-module="govuk-button" type="submit">
              Save and continue
            </button>
          </section>

          <section aria-labelledby="astro-text-input-heading" class="govuk-!-margin-bottom-9">
            <h2 class="govuk-heading-l" id="astro-text-input-heading">Text input</h2>
            <div class="govuk-form-group govuk-form-group--error">
              <label class="govuk-label" for="astro-national-insurance-number">
                National Insurance number
              </label>
              <div class="govuk-hint" id="astro-national-insurance-number-hint">
                It is on your National Insurance card, benefit letter, payslip or P60.
              </div>
              <p class="govuk-error-message" id="astro-national-insurance-number-error">
                <span class="govuk-visually-hidden">Error:</span>
                Enter a National Insurance number in the correct format
              </p>
              <input
                aria-describedby="astro-national-insurance-number-hint astro-national-insurance-number-error"
                class="govuk-input govuk-input--width-10 govuk-input--error"
                id="astro-national-insurance-number"
                name="nationalInsuranceNumber"
                spellcheck="false"
                type="text"
              />
            </div>
          </section>

          <section aria-labelledby="astro-accordion-heading">
            <h2 class="govuk-heading-l" id="astro-accordion-heading">Accordion</h2>
            <div
              class="govuk-accordion"
              data-module="govuk-accordion"
              id="astro-accordion-guidance"
            >
              <div class="govuk-accordion__section">
                <div class="govuk-accordion__section-header">
                  <h3 class="govuk-accordion__section-heading">
                    <span
                      class="govuk-accordion__section-button"
                      id="astro-accordion-guidance-heading-1"
                    >
                      Writing well for the web
                    </span>
                  </h3>
                </div>
                <div
                  class="govuk-accordion__section-content"
                  id="astro-accordion-guidance-content-1"
                >
                  <p class="govuk-body">This is the content for Writing well for the web.</p>
                </div>
              </div>
              <div class="govuk-accordion__section">
                <div class="govuk-accordion__section-header">
                  <h3 class="govuk-accordion__section-heading">
                    <span
                      class="govuk-accordion__section-button"
                      id="astro-accordion-guidance-heading-2"
                    >
                      Know your audience
                    </span>
                  </h3>
                </div>
                <div
                  class="govuk-accordion__section-content"
                  id="astro-accordion-guidance-content-2"
                >
                  <p class="govuk-body">This is the content for Know your audience.</p>
                </div>
              </div>
            </div>
          </section>
        </main>
      </div>
    </div>

    <script>
      const initialisedScopes = new WeakSet<Element>()

      async function initialiseGovuk() {
        const scope = document.querySelector('[data-govuk-astro-boundary]')
        if (!scope || initialisedScopes.has(scope)) return
        initialisedScopes.add(scope)

        try {
          const { initAll } = await import('govuk-frontend')
          if (!scope.isConnected) {
            initialisedScopes.delete(scope)
            return
          }

          initAll({
            scope,
            onError(error) {
              throw error
            }
          })

          window.__govukAstroFixtureReady = true
        } catch (error) {
          initialisedScopes.delete(scope)
          queueMicrotask(() => {
            throw error
          })
        }
      }

      void initialiseGovuk()
      document.addEventListener('astro:page-load', initialiseGovuk)
    </script>
  </body>
</html>
